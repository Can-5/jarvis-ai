# JARVIS ortam degiskenleri (ornek)
# Bu dosyanin kopyasini .env olarak olusturup degerleri doldurun.
# data/ (anahtarlar, veritabani) zaten .gitignore ile git'e gitmez.

# JARVIS data dizini (varsayilan: ./data)
JARVIS_DATA_DIR=./data

# AES-256-GCM anahtar kasasi icin master key (32 byte hex)
JARVIS_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Voice microservice URL'i (varsayilan: http://localhost:8765)
JARVIS_VOICE_URL=http://localhost:8765

# Telegram bot token'i (BotFather'dan aliniz, Faz-2)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Sunucu modu (1 => :3000'de dinle, systemd/bin/jarvis start ile kullanilir)
JARVIS_SERVE=1
